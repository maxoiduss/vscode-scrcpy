{
  "name": "scrcpy2",
  "displayName": "scrcpy2",
  "description": "Mirror, control, and record android device with scrcpy. (Updated)",
  "version": "1.1.0",
  "publisher": "ihsandev",
  "license": "SEE THE LICENSE FILE",
  "repository": "https://github.com/xiprox/vscode-scrcpy",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.71.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "scrcpy.mirror",
        "title": "mirror",
        "category": "scrcpy"
      },
      {
        "command": "scrcpy.mirrorConnection",
        "title": "define mirror connection type (tcp/ip, usb, serial)",
        "category": "scrcpy"
      },
      {
        "command": "scrcpy.mirrorAudioCodec",
        "title": "define mirror audio codec (opus, aac, flac, raw)",
        "category": "scrcpy"
      },
      {
        "command": "scrcpy.mirrorAlwaysOnTop",
        "title": "mirror (always on top)",
        "category": "scrcpy"
      },
      {
        "command": "scrcpy.mirrorBitRate",
        "title": "mirror (specify bit rate)",
        "category": "scrcpy"
      },
      {
        "command": "scrcpy.mirrorFrameRate",
        "title": "mirror (specify frame rate)",
        "category": "scrcpy"
      },
      {
        "command": "scrcpy.mirrorSize",
        "title": "mirror (specify size)",
        "category": "scrcpy"
      },
      {
        "command": "scrcpy.mirrorCrop",
        "title": "mirror (specify crop)",
        "category": "scrcpy"
      },
      {
        "command": "scrcpy.mirrorCustom",
        "title": "mirror (specify everything)",
        "category": "scrcpy"
      },
      {
        "command": "scrcpy.record",
        "title": "record",
        "category": "scrcpy"
      },
      {
        "command": "scrcpy.recordConnection",
        "title": "define record connection type (tcp/ip, usb, serial)",
        "category": "scrcpy"
      },
      {
        "command": "scrcpy.recordAudioCodec",
        "title": "define record audio codec (opus, aac, flac, raw)",
        "category": "scrcpy"
      },
      {
        "command": "scrcpy.recordBitRate",
        "title": "record (specify bit rate)",
        "category": "scrcpy"
      },
      {
        "command": "scrcpy.recordFrameRate",
        "title": "record (specify frame rate)",
        "category": "scrcpy"
      },
      {
        "command": "scrcpy.recordPath",
        "title": "record (specify path)",
        "category": "scrcpy"
      },
      {
        "command": "scrcpy.recordSize",
        "title": "record (specify size)",
        "category": "scrcpy"
      },
      {
        "command": "scrcpy.recordCrop",
        "title": "record (specify crop)",
        "category": "scrcpy"
      },
      {
        "command": "scrcpy.recordCustom",
        "title": "record (specify everything)",
        "category": "scrcpy"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint . --ext 'src/**/*.{js,ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{js,ts,tsx}' --fix",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^12.12.0",
    "@types/vscode": "^1.71.0",
    "@typescript-eslint/eslint-plugin": "^3.0.2",
    "@typescript-eslint/parser": "^3.0.2",
    "eslint": "^7.1.0",
    "typescript": "^4.8.3"
  }
}
